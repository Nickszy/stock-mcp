# Stock-MCP Container Environment
# Copy this file to .env and configure your settings

# ==================== Server ====================
MCP_PORT=9898

# ==================== Database ====================
POSTGRES_PASSWORD=stockmcp123
POSTGRES_DB=stockmcp

# Redis password (leave empty for no password)
REDIS_PASSWORD=

# External ports (change if conflicts)
REDIS_EXTERNAL_PORT=6379
POSTGRES_EXTERNAL_PORT=5432

# ==================== Data Sources ====================

# Tushare (A-share data, https://tushare.pro/)
TUSHARE_ENABLED=False
TUSHARE_TOKEN=
TUSHARE_HTTP_URL=

# Finnhub (US stock data, https://finnhub.io/)
FINNHUB_ENABLED=False
FINNHUB_API_KEY=

# Baostock (free A-share, no key needed)
BAOSTOCK_ENABLED=True

# ==================== Proxy ====================
# Enable if accessing foreign APIs from restricted regions
PROXY_ENABLED=False
PROXY_HOST=127.0.0.1
PROXY_PORT=7890

# ==================== Optional API Keys ====================
ALPHA_VANTAGE_API_KEY=
TWELVE_DATA_API_KEY=
NEWS_API_KEY=
TAVILY_API_KEY=
FRED_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
